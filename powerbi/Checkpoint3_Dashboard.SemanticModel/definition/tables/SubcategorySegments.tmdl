		sourceColumn: cluster

	column segment
		dataType: string
		lineageTag: 06fc1b81-8ec9-45cc-ba2a-969ee78bc6dc
		summarizeBy: none
		sourceColumn: segment

	measure 'Revenue Change 23 to 24' = SUM ( SubcategorySegments[revenue_2024] ) - SUM ( SubcategorySegments[revenue_2023] )
		formatString: #,0
		lineageTag: 9f8264c4-3ffc-466c-8aa6-aa0ab1d275ec

	partition SubcategorySegments = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(FolderPath & "subcategory_segments.csv"),
				        [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"sub_category_name", type text}, {"category_name", type text}, {"revenue_total", type number}, {"revenue_2023", type number}, {"revenue_2024", type number}, {"growth_pct", type number}, {"margin_pct", type number}, {"cluster", Int64.Type}, {"segment", type text}})
				in
				    Typed
