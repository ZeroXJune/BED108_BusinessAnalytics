table SubcategorySegments
	lineageTag: 5fa8ae23-338b-4557-8aaa-9115f87b44bb

	column sub_category_name
		dataType: string
		lineageTag: bd4255bd-d2e1-409d-bcc4-f2fa59e25edb
		summarizeBy: none
		sourceColumn: sub_category_name

	column category_name
		dataType: string
		lineageTag: ffe37d48-a681-4765-9ba4-b4f975a1a158
		summarizeBy: none
		sourceColumn: category_name

	column revenue_total
		dataType: double
		lineageTag: d1982a47-e745-4717-8d41-040fc225eaa1
		summarizeBy: sum
		sourceColumn: revenue_total

	column revenue_2023
		dataType: double
		lineageTag: 0e93b919-77b1-48ff-821a-f37261a7602d
		summarizeBy: sum
		sourceColumn: revenue_2023

	column revenue_2024
		dataType: double
		lineageTag: c4fbd0a2-57e4-4003-87cd-59e326bd1478
		summarizeBy: sum
		sourceColumn: revenue_2024

	column growth_pct
		dataType: double
		lineageTag: 3ae20e14-3f35-449e-b883-d999ccb8e0a3
		summarizeBy: sum
		sourceColumn: growth_pct

	column margin_pct
		dataType: double
		lineageTag: 95de32c1-1802-4b22-abea-c7b51850cf42
		summarizeBy: sum
		sourceColumn: margin_pct

	column cluster
		dataType: int64
		lineageTag: b1cb68e9-45a0-4505-b357-97e5b74064ec
