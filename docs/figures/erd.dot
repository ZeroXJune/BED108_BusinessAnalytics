digraph erd {
  graph [rankdir=LR, splines=polyline, nodesep=0.55, ranksep=1.5,
         bgcolor="white", fontname="Helvetica", pad=0.35];
  node  [shape=plaintext, fontname="Helvetica", color="#8fa3b5"];
  edge  [color="#8fa3b5", penwidth=1.3, arrowsize=0.9,
         fontname="Helvetica", fontsize=9, fontcolor="#5a6672"];

  categories [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#ffffff" COLOR="#8fa3b5"><TR><TD BGCOLOR="#dce6f1" COLSPAN="3" ALIGN="CENTER"><FONT COLOR="#1f2933" POINT-SIZE="13"><B>categories</B></FONT><BR/><FONT COLOR="#1f2933" POINT-SIZE="8">dimension</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="36"><FONT COLOR="#2f6f9f" POINT-SIZE="8"><B>PK</B></FONT></TD><TD ALIGN="LEFT" PORT="category_id"><FONT POINT-SIZE="10"><B>category_id</B></FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#5a6672" POINT-SIZE="8">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="36"> </TD><TD ALIGN="LEFT" PORT="category_name"><FONT POINT-SIZE="10">category_name</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#5a6672" POINT-SIZE="8">VARCHAR(60)</FONT></TD></TR></TABLE>>];
  cities [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#ffffff" COLOR="#8fa3b5"><TR><TD BGCOLOR="#dce6f1" COLSPAN="3" ALIGN="CENTER"><FONT COLOR="#1f2933" POINT-SIZE="13"><B>cities</B></FONT><BR/><FONT COLOR="#1f2933" POINT-SIZE="8">dimension</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="36"><FONT COLOR="#2f6f9f" POINT-SIZE="8"><B>PK</B></FONT></TD><TD ALIGN="LEFT" PORT="city_id"><FONT POINT-SIZE="10"><B>city_id</B></FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#5a6672" POINT-SIZE="8">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="36"> </TD><TD ALIGN="LEFT" PORT="city_name"><FONT POINT-SIZE="10">city_name</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#5a6672" POINT-SIZE="8">VARCHAR(60)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="36"><FONT COLOR="#2f6f9f" POINT-SIZE="8"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="state_id"><FONT POINT-SIZE="10"><B>state_id</B></FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#5a6672" POINT-SIZE="8">INT</FONT></TD></TR></TABLE>>];
  customers [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#ffffff" COLOR="#8fa3b5"><TR><TD BGCOLOR="#dce6f1" COLSPAN="3" ALIGN="CENTER"><FONT COLOR="#1f2933" POINT-SIZE="13"><B>customers</B></FONT><BR/><FONT COLOR="#1f2933" POINT-SIZE="8">dimension</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="36"><FONT COLOR="#2f6f9f" POINT-SIZE="8"><B>PK</B></FONT></TD><TD ALIGN="LEFT" PORT="customer_id"><FONT POINT-SIZE="10"><B>customer_id</B></FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#5a6672" POINT-SIZE="8">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="36"> </TD><TD ALIGN="LEFT" PORT="customer_name"><FONT POINT-SIZE="10">customer_name</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#5a6672" POINT-SIZE="8">VARCHAR(120)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="36"><FONT COLOR="#2f6f9f" POINT-SIZE="8"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="city_id"><FONT POINT-SIZE="10"><B>city_id</B></FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#5a6672" POINT-SIZE="8">INT</FONT></TD></TR></TABLE>>];
  dates [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#ffffff" COLOR="#8fa3b5"><TR><TD BGCOLOR="#dce6f1" COLSPAN="3" ALIGN="CENTER"><FONT COLOR="#1f2933" POINT-SIZE="13"><B>dates</B></FONT><BR/><FONT COLOR="#1f2933" POINT-SIZE="8">dimension</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="36"><FONT COLOR="#2f6f9f" POINT-SIZE="8"><B>PK</B></FONT></TD><TD ALIGN="LEFT" PORT="order_date"><FONT POINT-SIZE="10"><B>order_date</B></FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#5a6672" POINT-SIZE="8">DATE</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="36"> </TD><TD ALIGN="LEFT" PORT="year_number"><FONT POINT-SIZE="10">year_number</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#5a6672" POINT-SIZE="8">SMALLINT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="36"> </TD><TD ALIGN="LEFT" PORT="quarter_number"><FONT POINT-SIZE="10">quarter_number</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#5a6672" POINT-SIZE="8">TINYINT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="36"> </TD><TD ALIGN="LEFT" PORT="month_number"><FONT POINT-SIZE="10">month_number</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#5a6672" POINT-SIZE="8">TINYINT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="36"> </TD><TD ALIGN="LEFT" PORT="month_name"><FONT POINT-SIZE="10">month_name</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#5a6672" POINT-SIZE="8">VARCHAR(12)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="36"> </TD><TD ALIGN="LEFT" PORT="year_month"><FONT POINT-SIZE="10">year_month</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#5a6672" POINT-SIZE="8">CHAR(7)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="36"> </TD><TD ALIGN="LEFT" PORT="is_complete_year"><FONT POINT-SIZE="10">is_complete_year</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#5a6672" POINT-SIZE="8">TINYINT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="36"> </TD><TD ALIGN="LEFT" PORT="is_complete_month"><FONT POINT-SIZE="10">is_complete_month</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#5a6672" POINT-SIZE="8">TINYINT</FONT></TD></TR></TABLE>>];
  payment_modes [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#ffffff" COLOR="#8fa3b5"><TR><TD BGCOLOR="#dce6f1" COLSPAN="3" ALIGN="CENTER"><FONT COLOR="#1f2933" POINT-SIZE="13"><B>payment_modes</B></FONT><BR/><FONT COLOR="#1f2933" POINT-SIZE="8">dimension</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="36"><FONT COLOR="#2f6f9f" POINT-SIZE="8"><B>PK</B></FONT></TD><TD ALIGN="LEFT" PORT="payment_mode_id"><FONT POINT-SIZE="10"><B>payment_mode_id</B></FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#5a6672" POINT-SIZE="8">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="36"> </TD><TD ALIGN="LEFT" PORT="payment_mode_name"><FONT POINT-SIZE="10">payment_mode_name</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#5a6672" POINT-SIZE="8">VARCHAR(40)</FONT></TD></TR></TABLE>>];
  sales [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#ffffff" COLOR="#8fa3b5"><TR><TD BGCOLOR="#2f6f9f" COLSPAN="3" ALIGN="CENTER"><FONT COLOR="#ffffff" POINT-SIZE="13"><B>sales</B></FONT><BR/><FONT COLOR="#ffffff" POINT-SIZE="8">FACT TABLE</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="36"><FONT COLOR="#2f6f9f" POINT-SIZE="8"><B>PK</B></FONT></TD><TD ALIGN="LEFT" PORT="sale_id"><FONT POINT-SIZE="10"><B>sale_id</B></FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#5a6672" POINT-SIZE="8">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="36"> </TD><TD ALIGN="LEFT" PORT="order_ref"><FONT POINT-SIZE="10">order_ref</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#5a6672" POINT-SIZE="8">VARCHAR(20)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="36"><FONT COLOR="#2f6f9f" POINT-SIZE="8"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="order_date"><FONT POINT-SIZE="10"><B>order_date</B></FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#5a6672" POINT-SIZE="8">DATE</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="36"><FONT COLOR="#2f6f9f" POINT-SIZE="8"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="customer_id"><FONT POINT-SIZE="10"><B>customer_id</B></FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#5a6672" POINT-SIZE="8">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="36"><FONT COLOR="#2f6f9f" POINT-SIZE="8"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="sub_category_id"><FONT POINT-SIZE="10"><B>sub_category_id</B></FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#5a6672" POINT-SIZE="8">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="36"><FONT COLOR="#2f6f9f" POINT-SIZE="8"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="payment_mode_id"><FONT POINT-SIZE="10"><B>payment_mode_id</B></FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#5a6672" POINT-SIZE="8">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="36"> </TD><TD ALIGN="LEFT" PORT="quantity"><FONT POINT-SIZE="10">quantity</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#5a6672" POINT-SIZE="8">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="36"> </TD><TD ALIGN="LEFT" PORT="amount"><FONT POINT-SIZE="10">amount</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#5a6672" POINT-SIZE="8">DECIMAL(12, 2)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="36"> </TD><TD ALIGN="LEFT" PORT="profit"><FONT POINT-SIZE="10">profit</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#5a6672" POINT-SIZE="8">DECIMAL(12, 2)</FONT></TD></TR></TABLE>>];
  states [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#ffffff" COLOR="#8fa3b5"><TR><TD BGCOLOR="#dce6f1" COLSPAN="3" ALIGN="CENTER"><FONT COLOR="#1f2933" POINT-SIZE="13"><B>states</B></FONT><BR/><FONT COLOR="#1f2933" POINT-SIZE="8">dimension</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="36"><FONT COLOR="#2f6f9f" POINT-SIZE="8"><B>PK</B></FONT></TD><TD ALIGN="LEFT" PORT="state_id"><FONT POINT-SIZE="10"><B>state_id</B></FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#5a6672" POINT-SIZE="8">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="36"> </TD><TD ALIGN="LEFT" PORT="state_name"><FONT POINT-SIZE="10">state_name</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#5a6672" POINT-SIZE="8">VARCHAR(60)</FONT></TD></TR></TABLE>>];
  sub_categories [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#ffffff" COLOR="#8fa3b5"><TR><TD BGCOLOR="#dce6f1" COLSPAN="3" ALIGN="CENTER"><FONT COLOR="#1f2933" POINT-SIZE="13"><B>sub_categories</B></FONT><BR/><FONT COLOR="#1f2933" POINT-SIZE="8">dimension</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="36"><FONT COLOR="#2f6f9f" POINT-SIZE="8"><B>PK</B></FONT></TD><TD ALIGN="LEFT" PORT="sub_category_id"><FONT POINT-SIZE="10"><B>sub_category_id</B></FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#5a6672" POINT-SIZE="8">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="36"> </TD><TD ALIGN="LEFT" PORT="sub_category_name"><FONT POINT-SIZE="10">sub_category_name</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#5a6672" POINT-SIZE="8">VARCHAR(60)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="36"><FONT COLOR="#2f6f9f" POINT-SIZE="8"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="category_id"><FONT POINT-SIZE="10"><B>category_id</B></FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#5a6672" POINT-SIZE="8">INT</FONT></TD></TR></TABLE>>];

  states:state_id:e -> cities:state_id:w [dir=both, arrowtail=tee, arrowhead=crow];
  cities:city_id:e -> customers:city_id:w [dir=both, arrowtail=tee, arrowhead=crow];
  customers:customer_id:e -> sales:customer_id:w [dir=both, arrowtail=tee, arrowhead=crow];
  dates:order_date:e -> sales:order_date:w [dir=both, arrowtail=tee, arrowhead=crow];
  payment_modes:payment_mode_id:e -> sales:payment_mode_id:w [dir=both, arrowtail=tee, arrowhead=crow];
  sub_categories:sub_category_id:e -> sales:sub_category_id:w [dir=both, arrowtail=tee, arrowhead=crow];
  categories:category_id:e -> sub_categories:category_id:w [dir=both, arrowtail=tee, arrowhead=crow];

  subgraph cluster_legend {
    label=<<FONT POINT-SIZE="10" COLOR="#5a6672"><B>How to read this diagram</B></FONT>>;
    color="#8fa3b5"; style=dashed; fontname="Helvetica";
    legend [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="2" CELLPADDING="3"><TR><TD ALIGN="LEFT"><FONT COLOR="#2f6f9f" POINT-SIZE="9"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">primary key &#8212; uniquely identifies a row</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#2f6f9f" POINT-SIZE="9"><B>FK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">foreign key &#8212; points at another table&#8217;s primary key</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9"><B>&#8213;|</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">the &#8220;one&#8221; side of a relationship</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9"><B>&#8250;&#8212;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">crow&#8217;s foot &#8212; the &#8220;many&#8221; side</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#2f6f9f"> </TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">fact table (holds the measures)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#dce6f1"> </TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">dimension (describes and labels)</FONT></TD></TR></TABLE>>];
  }
}